# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in the values.
#  NEVER commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection used by the app.
# Supabase: use the "Transaction pooler" URL (port 6543) and add ?pgbouncer=true
DATABASE_URL="postgresql://postgres:local_password@localhost:5432/pkm_shop?schema=public"

# Direct (non-pooled) connection used only for migrations.
# Supabase: use the "Session" / direct URL (port 5432). Locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:local_password@localhost:5432/pkm_shop?schema=public"

# Public URL of the site (used in emails, sitemap, payment callbacks).
APP_URL="http://localhost:3000"
# Optional: old web addresses (comma-separated hosts) whose pages permanently redirect to APP_URL,
# e.g. after moving to a new domain. API routes (payment webhooks) are not redirected.
LEGACY_HOSTS=""

# Secret used to sign login sessions. Must be a long random string (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# First administrator account. Created by `npm run db:seed` if it doesn't exist yet.
# Log in at /login with these, then change the password from Account → Security.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="ChangeMe@12345"
ADMIN_NAME="Store Owner"

# Seed demo products/categories/blog posts when the catalog is empty (true/false).
SEED_DEMO_DATA="true"

# ── Online payments (optional) ── Razorpay: https://dashboard.razorpay.com/app/keys
# Leave empty to accept Cash on Delivery only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Razorpay Dashboard → Webhooks (URL: <APP_URL>/api/payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (optional) ── Without SMTP, emails are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Store <no-reply@example.com>"

# Protects the daily maintenance job (/api/cron/maintenance) run by Vercel Cron. Any long random string.
CRON_SECRET=""
